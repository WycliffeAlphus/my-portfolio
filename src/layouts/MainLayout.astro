---
import SEO from '../components/SEO.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  pathname?: string;
}

const {
  title,
  description = "Developer portfolio showcasing IoT, software, and DevOps projects",
  image,
} = Astro.props;

const fullTitle = `${title} | Wycliffe Onyango - Portfolio`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {image && <meta property="og:image" content={image} />}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">

    <!-- Theme color for browser -->
    <meta name="theme-color" content="#0a192f" />
  </head>
  <body>
    <header class="header">
      <div class="container">
        <div class="logo">
          <a href="/">wycliffe.onyango</a>
        </div>

        <button class="mobile-menu-toggle" aria-label="Toggle Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <!-- Navigation Bar -->
        <nav class="main-nav">
          <ul>
            <li><a href="/"><span class="nav-number">01.</span> home</a></li>
            <li><a href="/about"><span class="nav-number">02.</span> about</a></li>
            <li><a href="/projects"><span class="nav-number">03.</span> projects</a></li>
            <li><a href="/contact"><span class="nav-number">04.</span> contact</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <p>&copy; <span id="year"></span> Wycliffe Alphus Onyango. Built with passion and code.</p>
          <div class="social-links">
            <a href="https://github.com/WycliffeAlphus" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            </a>
            <a href="https://linkedin.com/in/wycliffe-alphus-onyango" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </a>
            <a href="https://x.com/WycliffeAlphus" target="_blank" rel="noopener noreferrer" aria-label="Twitter">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <style>
      /* Root variables - Dark Theme */
      :root {
        --navy: #0a192f;
        --light-navy: #112240;
        --lightest-navy: #233554;
        --navy-shadow: rgba(2, 12, 27, 0.7);
        --dark-slate: #495670;
        --slate: #8892b0;
        --light-slate: #a8b2d1;
        --lightest-slate: #ccd6f6;
        --white: #e6f1ff;
        --green: #64ffda;
        --green-tint: rgba(100, 255, 218, 0.1);
        --pink: #f57dff;
        --blue: #57cbff;

        --font-sans: 'Inter', -apple-system, system-ui, sans-serif;
        --font-mono: 'Fira Code', 'Monaco', 'Consolas', monospace;

        --transition: all 0.25s cubic-bezier(0.645, 0.045, 0.355, 1);
      }

      /* Base styles */
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: var(--font-sans);
        line-height: 1.6;
        color: var(--slate);
        margin: 0;
        padding: 0;
        background-color: var(--navy);
        min-height: 100vh;
        overflow-x: hidden;
      }

      .container {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        padding: 0 150px;
      }

      /* Header */
      .header {
        position: fixed;
        top: 0;
        width: 100%;
        background-color: rgba(10, 25, 47, 0.85);
        backdrop-filter: blur(10px);
        box-shadow: 0 10px 30px -10px var(--navy-shadow);
        padding: 0;
        z-index: 100;
        height: 100px;
        display: flex;
        align-items: center;
        transition: var(--transition);
      }

      .header.scrolled {
        height: 70px;
        box-shadow: 0 10px 30px -10px var(--navy-shadow);
      }

      .header .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo a {
        font-family: var(--font-mono);
        font-size: 16px;
        font-weight: 500;
        color: var(--green);
        text-decoration: none;
        transition: var(--transition);
      }

      .logo a:hover {
        color: var(--green);
        opacity: 0.8;
      }

      /* Main navigation */
      .main-nav ul {
        display: flex;
        list-style: none;
        margin: 0;
        padding: 0;
        gap: 40px;
        align-items: center;
      }

      .main-nav a {
        text-decoration: none;
        color: var(--lightest-slate);
        font-family: var(--font-mono);
        font-size: 13px;
        font-weight: 400;
        transition: var(--transition);
        position: relative;
        padding: 10px 0;
      }

      .nav-number {
        color: var(--green);
        margin-right: 5px;
        font-size: 12px;
      }

      .main-nav a:hover {
        color: var(--green);
      }

      /* Mobile menu toggle */
      .mobile-menu-toggle {
        display: none;
        flex-direction: column;
        justify-content: space-between;
        width: 30px;
        height: 21px;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        z-index: 101;
      }

      .mobile-menu-toggle span {
        display: block;
        width: 100%;
        height: 2px;
        background-color: var(--green);
        border-radius: 2px;
        transition: var(--transition);
      }

      /* Main content area */
      main {
        padding-top: 100px;
        min-height: 100vh;
      }

      /* Footer */
      .footer {
        background-color: var(--navy);
        padding: 20px 0;
        border-top: 1px solid var(--lightest-navy);
      }

      .footer-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
      }

      .footer p {
        color: var(--slate);
        font-family: var(--font-mono);
        font-size: 12px;
        margin: 0;
      }

      .social-links {
        display: flex;
        gap: 20px;
      }

      .social-links a {
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--slate);
        transition: var(--transition);
      }

      .social-links a:hover {
        color: var(--green);
        transform: translateY(-3px);
      }

      .social-links svg {
        stroke: currentColor;
        transition: var(--transition);
      }

      /* Responsive styles */
      @media (max-width: 1080px) {
        .container {
          padding: 0 100px;
        }
      }

      @media (max-width: 768px) {
        .container {
          padding: 0 50px;
        }

        .header {
          height: 70px;
          padding: 0;
        }

        .mobile-menu-toggle {
          display: flex;
        }

        .main-nav {
          position: fixed;
          top: 0;
          right: -100%;
          width: min(75vw, 400px);
          height: 100vh;
          background-color: var(--light-navy);
          box-shadow: -10px 0 30px -15px var(--navy-shadow);
          padding: 100px 50px;
          transition: var(--transition);
          z-index: 100;
        }

        .main-nav.active {
          right: 0;
        }

        .main-nav ul {
          flex-direction: column;
          gap: 30px;
          align-items: flex-start;
        }

        .main-nav a {
          font-size: 16px;
        }

        .nav-number {
          display: block;
          margin-bottom: 5px;
        }

        .menu-open {
          overflow: hidden;
        }

        .menu-open .mobile-menu-toggle span:nth-child(1) {
          transform: translateY(9px) rotate(45deg);
        }

        .menu-open .mobile-menu-toggle span:nth-child(2) {
          opacity: 0;
        }

        .menu-open .mobile-menu-toggle span:nth-child(3) {
          transform: translateY(-10px) rotate(-45deg);
        }

        main {
          padding-top: 70px;
        }

        .footer-content {
          flex-direction: column;
          text-align: center;
        }
      }

      @media (max-width: 480px) {
        .container {
          padding: 0 25px;
        }

        .main-nav {
          padding: 80px 30px;
        }
      }
    </style>

    <script>
      // Mobile menu toggle functionality
      const menuToggle = document.querySelector('.mobile-menu-toggle');
      const mainNav = document.querySelector('.main-nav');
      const body = document.body;

      menuToggle?.addEventListener('click', () => {
        body.classList.toggle('menu-open');
        mainNav?.classList.toggle('active');
      });

      // Close menu when clicking nav links
      document.querySelectorAll('.main-nav a').forEach(link => {
        link.addEventListener('click', () => {
          body.classList.remove('menu-open');
          mainNav?.classList.remove('active');
        });
      });

      // Header scroll effect
      let lastScroll = 0;
      const header = document.querySelector('.header');

      window.addEventListener('scroll', () => {
        const currentScroll = window.pageYOffset;

        if (currentScroll > 0) {
          header?.classList.add('scrolled');
        } else {
          header?.classList.remove('scrolled');
        }

        lastScroll = currentScroll;
      });

      // Set current year
      const yearElement = document.getElementById('year');
      if (yearElement) {
        yearElement.textContent = new Date().getFullYear().toString();
      }
    </script>
  </body>
</html>
