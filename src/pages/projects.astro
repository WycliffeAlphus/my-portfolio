---
import MainLayout from '../layouts/MainLayout.astro';

// You could fetch this from a CMS or local data file
const projects = [
  {
    title: "Id-Track",
    category: "IoT",
    description: "ID Track is a smart access and tracking system that uses ID cards to monitor and log entries and exits in various locations. It can be used for schools, offices, gyms, events, and more. The system ensures secure access management while providing real-time tracking and reporting.",
    image: "/assets/project1.jpg",
    tags: ["Arduino", "ESP32", "MQTT", "Python", "C++"],
    link: "https://www.linkedin.com/posts/wycliffe-alphus-onyango_gps-iot-techinnovation-activity-7309635038583640064-8t0T?utm_source=share&utm_medium=member_desktop&rcm=ACoAAErgyE0BAVqJ0KjVHjv1f5MpBVMoEgM6KzQ"
  },
  {
    title: "IoT Device Security Protocol",
    category: "IoT",
    description: "The IoT Device Security Protocol is a framework designed to secure IoT devices by providing authentication, encryption, and integrity for device communication and management. This protocol helps protect sensitive data, prevent unauthorized access, and ensure secure device updates.",
    image: "/assets/IoT.jpeg",
    tags: ["Arduino", "ESP32", "MQTT", "Go", "C++"],
    link: "https://github.com/WycliffeAlphus/IOT-Device-Security-Protocol"
  },
  {
    title: "Personal Portfolio Website",
    category: "Software Development",
    description: "A fast, responsive portfolio website built with Astro and modern web technologies.",
    image: "/assets/port.png",
    tags: ["Astro", "HTML", "CSS", "JavaScript"],
    link: "#"
  },

  {
    title: "url-shortener",
    category: "Software Development",
    description: "The program accepts a long URL and returns a shortened URL.",
    image: "/assets/url.png",
    tags: ["Go", "Docker", "HTML", "CSS", "JavaScript"],
    link: "https://url-kms9.onrender.com/"
  },

  {
    title: "CI/CD Pipeline Setup",
    category: "DevOps",
    description: "Automated build, test, and deployment pipeline for a microservice architecture.",
    image: "/assets/project3.png",
    tags: ["GitHub Actions", "Docker", "Kubernetes", "AWS"],
    link: "#"
  },
  // more projects as needed
];
---

<MainLayout title="Projects">
  <section class="projects">
    <div class="container">
      <div class="page-header">
        <h1><span class="section-number">03.</span> My Projects</h1>
      </div>

      <div class="filters">
        <button class="filter-btn active" data-filter="all">All</button>
        <button class="filter-btn" data-filter="IoT">IoT</button>
        <button class="filter-btn" data-filter="Software Development">Software</button>
        <button class="filter-btn" data-filter="DevOps">DevOps</button>
      </div>

      <div class="projects-grid">
        {projects.map(project => (
          <div class="project-card" data-category={project.category}>
            <div class="project-image">
              <img src={project.image} alt={project.title} />
              <div class="project-overlay">
                <a href={project.link} class="view-project-btn" target="_blank" rel="noopener noreferrer">View Project</a>
              </div>
            </div>
            <div class="project-content">
              <span class="project-category">{project.category}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="tags">
                {project.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</MainLayout>

<script>
  // Simple filtering functionality
  const filterButtons = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      // Update active button
      filterButtons.forEach(btn => btn.classList.remove('active'));
      button.classList.add('active');

      // Filter projects
      const filter = button.getAttribute('data-filter');

      projectCards.forEach(card => {
        if (card instanceof HTMLElement) {
          if (filter === 'all' || card.getAttribute('data-category') === filter) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        }
      });
    });
  });
</script>

<style>
  /* Container */
  .container {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 150px;
  }

  /* Projects Section */
  .projects {
    padding: 50px 0 100px;
    min-height: 100vh;
  }

  /* Page Header */
  .page-header {
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: clamp(26px, 5vw, 32px);
    font-weight: 700;
    color: var(--lightest-slate);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-number {
    font-family: var(--font-mono);
    color: var(--green);
    font-size: clamp(16px, 3vw, 20px);
  }

  /* Filters */
  .filters {
    display: flex;
    gap: 1rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.6rem 1.5rem;
    background-color: transparent;
    color: var(--slate);
    border: 1px solid var(--lightest-navy);
    border-radius: 4px;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 13px;
    transition: var(--transition);
  }

  .filter-btn:hover {
    color: var(--green);
    border-color: var(--green);
  }

  .filter-btn.active {
    background-color: var(--green-tint);
    color: var(--green);
    border-color: var(--green);
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }

  .project-card {
    background-color: var(--light-navy);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--lightest-navy);
    transition: var(--transition);
  }

  .project-card:hover {
    transform: translateY(-8px);
    border-color: var(--green);
    box-shadow: 0 10px 30px -15px var(--navy-shadow);
  }

  .project-image {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background-color: var(--lightest-navy);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
  }

  .project-card:hover .project-image img {
    transform: scale(1.05);
    filter: brightness(0.7);
  }

  .project-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 25, 47, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition);
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .view-project-btn {
    padding: 0.75rem 1.5rem;
    background-color: transparent;
    color: var(--green);
    border: 1px solid var(--green);
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 13px;
    transition: var(--transition);
  }

  .view-project-btn:hover {
    background-color: var(--green-tint);
  }

  .project-content {
    padding: 1.5rem;
  }

  .project-category {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--green);
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  .project-content h3 {
    font-size: 1.4rem;
    color: var(--lightest-slate);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .project-content p {
    color: var(--slate);
    line-height: 1.6;
    margin-bottom: 1rem;
    font-size: 15px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tag {
    background-color: var(--lightest-navy);
    color: var(--light-slate);
    padding: 0.25rem 0.75rem;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* Responsive Design */
  @media (max-width: 1080px) {
    .container {
      padding: 0 100px;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 50px;
    }

    .projects {
      padding: 30px 0 80px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-image {
      height: 200px;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 25px;
    }

    .filters {
      gap: 0.75rem;
    }

    .filter-btn {
      padding: 0.5rem 1rem;
      font-size: 12px;
    }
  }
</style>
