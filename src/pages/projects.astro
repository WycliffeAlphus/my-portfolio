---
import MainLayout from '../layouts/MainLayout.astro';

const projects = [
  {
    title: "IoT Device Security Protocol",
    category: "IoT",
    description: "A framework designed to secure IoT devices by providing authentication, encryption, and integrity for device communication and management. Protects sensitive data, prevents unauthorized access, and ensures secure device updates.",
    image: "/assets/IoT.jpeg",
    tags: ["Arduino", "ESP32", "MQTT", "Go", "C++"],
    link: "https://github.com/WycliffeAlphus/IOT-Device-Security-Protocol"
  },
  {
    title: "ID-Track",
    category: "IoT",
    description: "A smart access and tracking system that uses ID cards to monitor and log entries and exits in various locations — schools, offices, gyms, events, and more. Provides secure access management with real-time tracking and reporting.",
    image: "/assets/project1.jpg",
    tags: ["Arduino", "ESP32", "MQTT", "Python", "C++"],
    link: "https://www.linkedin.com/posts/wycliffe-alphus-onyango_gps-iot-techinnovation-activity-7309635038583640064-8t0T?utm_source=share&utm_medium=member_desktop&rcm=ACoAAErgyE0BAVqJ0KjVHjv1f5MpBVMoEgM6KzQ"
  },
  {
    title: "CortexVault",
    category: "Software Development",
    description: "A decentralized platform for Kenyan patients to maintain control over their brain/EEG data while enabling medical research. Features encrypted storage on Filecoin via Storacha, granular researcher access controls, complete audit trails, and a bilingual (English/Swahili) mobile-first interface aligned with Kenya's Data Protection Act.",
    image: "/assets/cortexvault.png",
    tags: ["Filecoin", "Storacha", "Go", "TypeScript"],
    link: "https://github.com/WycliffeAlphus/cortexvault"
  },
  {
    title: "RDBMS From Scratch",
    category: "Software Development",
    description: "A relational database management system built from scratch in Python. Supports full SQL (CREATE, INSERT, SELECT, UPDATE, DELETE), INNER JOINs, WHERE clause evaluation, hash-based indexing, multiple data types, and constraint enforcement (PRIMARY KEY, UNIQUE, NOT NULL).",
    image: "/assets/url.png",
    tags: ["Python", "SQL", "Data Structures"],
    link: "https://github.com/WycliffeAlphus/rdbms-project"
  },
];
---

<MainLayout title="Projects">
  <section class="projects">
    <div class="container">
      <div class="page-header">
        <h1><span class="section-number">03.</span> My Projects</h1>
      </div>

      <div class="projects-grid">
        {projects.map(project => (
          <div class="project-card">
            <div class="project-image">
              <img src={project.image} alt={project.title} />
              <div class="project-overlay">
                <a href={project.link} class="view-project-btn" target="_blank" rel="noopener noreferrer">View Project</a>
              </div>
            </div>
            <div class="project-content">
              <span class="project-category">{project.category}</span>
              <h3>{project.title}</h3>
              <p>{project.description}</p>
              <div class="tags">
                {project.tags.map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Container */
  .container {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 150px;
  }

  /* Projects Section */
  .projects {
    padding: 50px 0 100px;
    min-height: 100vh;
  }

  /* Page Header */
  .page-header {
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: clamp(26px, 5vw, 32px);
    font-weight: 700;
    color: var(--lightest-slate);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-number {
    font-family: var(--font-mono);
    color: var(--green);
    font-size: clamp(16px, 3vw, 20px);
  }

  /* Projects Grid */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }

  .project-card {
    background-color: var(--light-navy);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--lightest-navy);
    transition: var(--transition);
  }

  .project-card:hover {
    transform: translateY(-8px);
    border-color: var(--green);
    box-shadow: 0 10px 30px -15px var(--navy-shadow);
  }

  .project-image {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
    background-color: var(--lightest-navy);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
  }

  .project-card:hover .project-image img {
    transform: scale(1.05);
    filter: brightness(0.7);
  }

  .project-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(10, 25, 47, 0.9);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: var(--transition);
  }

  .project-card:hover .project-overlay {
    opacity: 1;
  }

  .view-project-btn {
    padding: 0.75rem 1.5rem;
    background-color: transparent;
    color: var(--green);
    border: 1px solid var(--green);
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 13px;
    transition: var(--transition);
  }

  .view-project-btn:hover {
    background-color: var(--green-tint);
  }

  .project-content {
    padding: 1.5rem;
  }

  .project-category {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--green);
    margin-bottom: 0.5rem;
    display: inline-block;
  }

  .project-content h3 {
    font-size: 1.4rem;
    color: var(--lightest-slate);
    margin-bottom: 0.75rem;
    font-weight: 600;
  }

  .project-content p {
    color: var(--slate);
    line-height: 1.6;
    margin-bottom: 1rem;
    font-size: 15px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tag {
    background-color: var(--lightest-navy);
    color: var(--light-slate);
    padding: 0.25rem 0.75rem;
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 12px;
  }

  /* Responsive Design */
  @media (max-width: 1080px) {
    .container {
      padding: 0 100px;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 50px;
    }

    .projects {
      padding: 30px 0 80px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .project-image {
      height: 200px;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 25px;
    }

    .filters {
      gap: 0.75rem;
    }

    .filter-btn {
      padding: 0.5rem 1rem;
      font-size: 12px;
    }
  }
</style>
