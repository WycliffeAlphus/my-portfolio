---
import MainLayout from "../layouts/MainLayout.astro";
const pathname = Astro.url.pathname;
---
<MainLayout title="About" pathname={pathname}>
  <section class="about">
    <div class="container">
      <div class="page-header">
        <h1><span class="section-number">02.</span> About Me</h1>
      </div>

      <div class="bio-section">
        <div class="bio-content">
          <h2>About Me</h2>
          <p>
            I'm a versatile Software Developer, Embedded Systems Engineer, and DevOps Engineer who builds integrated systems that connect hardware, software, and cloud infrastructure.
          </p>
          <p>
            I work at <strong>Code & Circuits</strong> as the Chief Technology Officer (CTO) and Embedded Systems Engineer, creating IoT and automation solutions using microcontrollers, sensors, and real-world electronics to solve practical problems. I also serve as a DevOps Engineer at <strong>Zone01 Kisumu</strong>, where I develop systems and automation pipelines powered by modern DevOps practices such as CI/CD, cloud computing (AWS), and infrastructure as code with Terraform, as well as containerization using Docker and Kubernetes.
          </p>
          <p>
            I program in Go, Rust, JavaScript, Python, and C++, enabling me to work confidently across low-level embedded systems, backend services, and cloud-native environments. Passionate about system reliability and the convergence of hardware and cloud technologies, I focus on building scalable, secure architectures that deliver real-world impact.
          </p>
          <p>
            Driven by a commitment to sustainable innovation, I aim to contribute to solutions that shape a more connected and future-ready world.
          </p>
        </div>
        <div class="bio-image">
          <div class="video-window">
            <div class="window-header">
              <div class="window-controls">
                <span class="control-dot red"></span>
                <span class="control-dot yellow"></span>
                <span class="control-dot green"></span>
              </div>
            </div>
            <div class="video-content">
              <img src="/assets/about-me.jpg" alt="Professional photo" />
            </div>
            <div class="video-controls">
              <button class="control-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M23 7l-7 5 7 5V7z"></path>
                  <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
                </svg>
              </button>
              <button class="control-btn">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path>
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                  <line x1="12" y1="19" x2="12" y2="23"></line>
                  <line x1="8" y1="23" x2="16" y2="23"></line>
                </svg>
              </button>
              <button class="control-btn hangup">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <div class="skills-section">
        <h2>Skills & Expertise</h2>

        <div class="skills-grid">
          <div class="skill-category">
            <div class="category-header">
              <span class="category-icon">🌐</span>
              <h3>IoT Development</h3>
            </div>
            <div class="skill-bars">
              <div class="skill">
                <div class="skill-header">
                  <span class="skill-name">Arduino</span>
                  <span class="skill-percentage">90%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: 90%"></div></div>
              </div>
              <div class="skill">
                <div class="skill-header">
                  <span class="skill-name">Raspberry Pi</span>
                  <span class="skill-percentage">85%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: 85%"></div></div>
              </div>
              <div class="skill">
                <div class="skill-header">
                  <span class="skill-name">MQTT</span>
                  <span class="skill-percentage">80%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: 80%"></div></div>
              </div>
            </div>
          </div>

          <div class="skill-category">
            <div class="category-header">
              <span class="category-icon">💻</span>
              <h3>Software Development</h3>
            </div>
            <div class="skill-bars">
              <div class="skill">
                <div class="skill-header">
                  <span class="skill-name">Go</span>
                  <span class="skill-percentage">95%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: 95%"></div></div>
              </div>
              <div class="skill">
                <div class="skill-header">
                  <span class="skill-name">Rust</span>
                  <span class="skill-percentage">85%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: 85%"></div></div>
              </div>
              <div class="skill">
                <div class="skill-header">
                  <span class="skill-name">JavaScript/TypeScript</span>
                  <span class="skill-percentage">90%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: 90%"></div></div>
              </div>
              <div class="skill">
                <div class="skill-header">
                  <span class="skill-name">Python</span>
                  <span class="skill-percentage">85%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: 85%"></div></div>
              </div>
              <div class="skill">
                <div class="skill-header">
                  <span class="skill-name">C++</span>
                  <span class="skill-percentage">80%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: 80%"></div></div>
              </div>
            </div>
          </div>

          <div class="skill-category">
            <div class="category-header">
              <span class="category-icon">☁️</span>
              <h3>DevOps & Cloud</h3>
            </div>
            <div class="skill-bars">
              <div class="skill">
                <div class="skill-header">
                  <span class="skill-name">Docker & Kubernetes</span>
                  <span class="skill-percentage">85%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: 85%"></div></div>
              </div>
              <div class="skill">
                <div class="skill-header">
                  <span class="skill-name">AWS</span>
                  <span class="skill-percentage">80%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: 80%"></div></div>
              </div>
              <div class="skill">
                <div class="skill-header">
                  <span class="skill-name">Terraform</span>
                  <span class="skill-percentage">75%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: 75%"></div></div>
              </div>
              <div class="skill">
                <div class="skill-header">
                  <span class="skill-name">CI/CD Pipelines</span>
                  <span class="skill-percentage">85%</span>
                </div>
                <div class="progress-bar"><div class="progress-fill" style="width: 85%"></div></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  /* Container */
  .container {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 150px;
  }

  /* About Section */
  .about {
    padding: 50px 0 100px;
    min-height: 100vh;
  }

  /* Page Header */
  .page-header {
    margin-bottom: 4rem;
  }

  .page-header h1 {
    font-size: clamp(26px, 5vw, 32px);
    font-weight: 700;
    color: var(--lightest-slate);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-number {
    font-family: var(--font-mono);
    color: var(--green);
    font-size: clamp(16px, 3vw, 20px);
  }

  /* Bio Section */
  .bio-section {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 50px;
    margin-bottom: 5rem;
    align-items: start;
  }

  .bio-content h2 {
    font-size: 1.8rem;
    color: var(--lightest-slate);
    margin-bottom: 1.5rem;
    position: relative;
    display: inline-block;
  }

  .bio-content h2:after {
    content: "";
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 40px;
    height: 3px;
    background-color: var(--green);
  }

  .bio-content p {
    font-size: 18px;
    line-height: 1.8;
    color: var(--slate);
    margin-bottom: 20px;
  }

  .bio-image {
    display: flex;
    justify-content: center;
  }

  /* Video Window Styling */
  .video-window {
    width: 100%;
    max-width: 350px;
    background-color: #0a192f;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid var(--lightest-navy);
    box-shadow: 0 20px 60px -10px rgba(0, 0, 0, 0.5);
    transition: var(--transition);
  }

  .video-window:hover {
    transform: translateY(-5px);
    box-shadow: 0 25px 70px -10px rgba(0, 0, 0, 0.6);
  }

  .window-header {
    background-color: #0a1628;
    padding: 12px 16px;
    border-bottom: 1px solid var(--lightest-navy);
  }

  .window-controls {
    display: flex;
    gap: 8px;
  }

  .control-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: block;
  }

  .control-dot.red {
    background-color: #ff5f57;
  }

  .control-dot.yellow {
    background-color: #febc2e;
  }

  .control-dot.green {
    background-color: #28c840;
  }

  .video-content {
    position: relative;
    width: 100%;
    background-color: #0d1b2a;
  }

  .video-content img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .video-controls {
    background-color: #0a1628;
    padding: 12px;
    display: flex;
    justify-content: center;
    gap: 12px;
    border-top: 1px solid var(--lightest-navy);
  }

  .control-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background-color: var(--lightest-navy);
    color: var(--light-slate);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition);
  }

  .control-btn:hover {
    background-color: var(--lightest-slate);
    color: var(--navy);
  }

  .control-btn.hangup {
    background-color: #dc2626;
    color: white;
  }

  .control-btn.hangup:hover {
    background-color: #b91c1c;
  }

  /* Skills Section */
  .skills-section {
    padding-top: 2rem;
  }

  .skills-section h2 {
    font-size: 1.8rem;
    color: var(--lightest-slate);
    margin-bottom: 2.5rem;
    position: relative;
    display: inline-block;
  }

  .skills-section h2:after {
    content: "";
    position: absolute;
    bottom: -8px;
    left: 0;
    width: 40px;
    height: 3px;
    background-color: var(--green);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2.5rem;
  }

  /* Skill Categories */
  .skill-category {
    background-color: var(--light-navy);
    border-radius: 8px;
    padding: 1.5rem;
    border: 1px solid var(--lightest-navy);
    transition: var(--transition);
  }

  .skill-category:hover {
    transform: translateY(-5px);
    border-color: var(--green);
    box-shadow: 0 10px 30px -15px var(--navy-shadow);
  }

  .category-header {
    display: flex;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .category-icon {
    font-size: 1.8rem;
    margin-right: 0.75rem;
  }

  .skill-category h3 {
    font-size: 1.3rem;
    color: var(--lightest-slate);
    font-weight: 600;
    margin: 0;
  }

  /* Skill Bars */
  .skill {
    margin-bottom: 1.25rem;
  }

  .skill:last-child {
    margin-bottom: 0;
  }

  .skill-header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .skill-name {
    font-weight: 500;
    color: var(--light-slate);
  }

  .skill-percentage {
    font-weight: 600;
    color: var(--green);
    font-family: var(--font-mono);
    font-size: 14px;
  }

  .progress-bar {
    height: 8px;
    background-color: var(--lightest-navy);
    border-radius: 10px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--green);
    border-radius: 10px;
    transition: width 1s ease-in-out;
  }

  /* Responsive Design */
  @media (max-width: 1080px) {
    .container {
      padding: 0 100px;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 50px;
    }

    .bio-section {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .bio-image {
      order: -1;
    }

    .video-window {
      max-width: 100%;
      margin: 0 auto;
    }

    .bio-content h2,
    .skills-section h2 {
      text-align: center;
    }

    .bio-content h2:after,
    .skills-section h2:after {
      left: 50%;
      transform: translateX(-50%);
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 25px;
    }

    .about {
      padding: 30px 0 80px;
    }

    .bio-content p {
      font-size: 16px;
    }
  }
</style>
