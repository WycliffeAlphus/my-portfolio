---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact">
  <section class="contact">
    <div class="container">
      <div class="page-header">
        <h1><span class="section-number">04.</span> Get in Touch</h1>
      </div>

      <div class="contact-container">
        <div class="contact-info">
          <h2 class="section-title">Contact Information</h2>
          <p class="contact-intro">Feel free to reach out to me through any of the following methods:</p>

          <div class="contact-method">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span>+254718680481</span>
          </div>

          <div class="contact-method">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            <span>wycliffealphus7@gmail.com</span>
          </div>

          <div class="contact-method">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path></svg>
            <span>Kisumu, Kenya</span>
          </div>

          <div class="social-links">
            <h3 class="social-title">Follow Me</h3>
            <div class="social-icons">
              <a href="https://github.com/WycliffeAlphus" target="_blank" rel="noopener" aria-label="GitHub">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
              </a>
              <a href="https://www.linkedin.com/in/wycliffe-alphus-onyango/" target="_blank" rel="noopener" aria-label="LinkedIn">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
              </a>
              <a href="https://x.com/WycliffeAlphus" target="_blank" rel="noopener" aria-label="X (Twitter)">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" fill="currentColor"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div class="contact-form">
          <h2 class="section-title">Send Me a Message</h2>
          <form id="contactForm">
            <div class="form-group">
              <label for="name">Name</label>
              <input type="text" id="name" name="name" required />
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" required />
            </div>

            <div class="form-group">
              <label for="subject">Subject</label>
              <input type="text" id="subject" name="subject" required />
            </div>

            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="5" required></textarea>
            </div>

            <button type="submit" class="submit-button">Send Message</button>
          </form>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  // Form submission handling (client-side only)
  const contactForm = document.getElementById('contactForm') as HTMLFormElement;

  if (contactForm) {
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();

      alert('Your message has been sent! (This is just a demonstration)');
      contactForm.reset();
    });
  }
</script>

<style>
  /* Container */
  .container {
    width: 100%;
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 150px;
  }

  /* Contact Section */
  .contact {
    padding: 50px 0 100px;
    min-height: 100vh;
  }

  /* Page Header */
  .page-header {
    margin-bottom: 3rem;
  }

  .page-header h1 {
    font-size: clamp(26px, 5vw, 32px);
    font-weight: 700;
    color: var(--lightest-slate);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-number {
    font-family: var(--font-mono);
    color: var(--green);
    font-size: clamp(16px, 3vw, 20px);
  }

  /* Contact Container */
  .contact-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .section-title {
    font-size: 1.8rem;
    margin-bottom: 1.5rem;
    color: var(--lightest-slate);
    position: relative;
    display: inline-block;
  }

  .section-title::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -8px;
    width: 50px;
    height: 3px;
    background-color: var(--green);
  }

  .contact-intro {
    font-size: 1.1rem;
    margin-bottom: 2rem;
    margin-top: 2rem;
    color: var(--slate);
    line-height: 1.6;
  }

  .contact-method {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--lightest-navy);
  }

  .contact-method svg {
    color: var(--green);
    flex-shrink: 0;
  }

  .contact-method span {
    font-size: 1.05rem;
    color: var(--light-slate);
  }

  .social-links {
    margin-top: 2.5rem;
  }

  .social-title {
    font-size: 1.4rem;
    margin-bottom: 1rem;
    color: var(--lightest-slate);
  }

  .social-icons {
    display: flex;
    gap: 1.2rem;
    margin-top: 0.5rem;
  }

  .social-icons a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    background-color: var(--lightest-navy);
    color: var(--slate);
    transition: var(--transition);
    border: 1px solid var(--lightest-navy);
  }

  .social-icons a:hover {
    background-color: var(--green-tint);
    color: var(--green);
    border-color: var(--green);
    transform: translateY(-3px);
  }

  /* Contact Form */
  .contact-form {
    background-color: var(--light-navy);
    padding: 2rem;
    border-radius: 8px;
    border: 1px solid var(--lightest-navy);
  }

  .form-group {
    margin-bottom: 1.8rem;
  }

  label {
    display: block;
    margin-bottom: 0.6rem;
    font-weight: 500;
    color: var(--light-slate);
    font-size: 14px;
  }

  input, textarea {
    width: 100%;
    padding: 0.9rem;
    border: 1px solid var(--lightest-navy);
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
    transition: var(--transition);
    background-color: var(--navy);
    color: var(--lightest-slate);
  }

  input:focus, textarea:focus {
    outline: none;
    border-color: var(--green);
    box-shadow: 0 0 0 3px var(--green-tint);
  }

  textarea {
    resize: vertical;
    min-height: 120px;
  }

  .submit-button {
    padding: 0.9rem 2rem;
    background-color: transparent;
    color: var(--green);
    border: 1px solid var(--green);
    border-radius: 4px;
    cursor: pointer;
    font-weight: 600;
    font-family: var(--font-mono);
    font-size: 14px;
    transition: var(--transition);
    display: inline-block;
  }

  .submit-button:hover {
    background-color: var(--green-tint);
    transform: translateY(-2px);
  }

  /* Responsive Design */
  @media (max-width: 1080px) {
    .container {
      padding: 0 100px;
    }
  }

  @media (max-width: 900px) {
    .container {
      padding: 0 50px;
    }

    .contact-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .section-title {
      font-size: 1.6rem;
    }

    .social-icons a {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 0 25px;
    }

    .contact {
      padding: 30px 0 80px;
    }

    .contact-form {
      padding: 1.5rem;
    }

    .submit-button {
      width: 100%;
      text-align: center;
    }
  }
</style>
